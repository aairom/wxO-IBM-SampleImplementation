# ==============================================================================
# IBM Documentation Assistant (IBM_Doc_Assistant) Environment Configuration
# ==============================================================================

# IBM Cloud & watsonx Credentials
IBM_WATSONX_API_KEY=your-ibm-cloud-api-key-here
ORCHESTRATE_INSTANCE_URL=https://api.watsonx.orchestrate.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# Agent & Identity
AGENT_NAME=IBM_Doc_Assistant
AGENT_MODEL=groq/openai/gpt-oss-120b
AGENT_YAML_PATH=agents/ibm_doc_assistant.agent.yaml
TOOLS_MODULE_PATH=src/agents/ibm_doc_agent/tools.py

# Ingestion Pipeline & Vector Store Settings
VECTOR_DB_ENDPOINT=local
VECTOR_STORE_PATH=knowledge-bases/ibm_doc_store.json
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; IBMWatsonxDocIngestion/1.0; +https://www.ibm.com)
SCRAPER_TIMEOUT=15
SCRAPER_MAX_RETRIES=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Runtime Logging & Output
LOG_LEVEL=INFO
REPORT_DIR=output
