# ==============================================================================
# IBM Bob Documentation Assistant — watsonx Orchestrate
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to source control — it is already listed in .gitignore.
# ==============================================================================

# ── watsonx Orchestrate ────────────────────────────────────────────────────────
# Full API service URL (NOT the console URL).
# Format: https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<INSTANCE_ID>
ORCHESTRATE_URL=

# IBM Cloud API Key used to authenticate the `orchestrate` CLI against the
# IBM IAM token service. Generate / rotate at: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=

# ── Optional: environment alias ───────────────────────────────────────────────
# Friendly name for the `orchestrate env add` registration.
# If omitted, the scripts default to "wxo-ibm-bob".
ORCHESTRATE_ENV_NAME=wxo-ibm-bob

# ── Optional: KB doc refresh (scripts/fetch_ibm_bob_docs.py) ──────────────────
# Set these only if you need to regenerate the KB .txt files from the live
# Bob internal search API. Leave blank if you are using the pre-populated files.
BOB_SEARCH_API_URL=
BOB_SEARCH_API_TOKEN=

# ── Secured embed chat (JWT mode) ──────────────────────────────────────────────
# Required only when using the secured embed (demo-secured.html).
# Leave blank for the unsecured embed (demo-unsecured.html).
#
# 1. Generate a key pair:  bash scripts/generate_rsa_keys.sh
# 2. Upload the public key to:
#      https://eu-de.watson-orchestrate.cloud.ibm.com
#      → Administration → Settings → Embed Security → Security: ON
# 3. Set the path below and start the JWT server:
#      python scripts/jwt_server.py
#
# Path to the RSA-2048 private key PEM file (relative to project root).
EMBED_PRIVATE_KEY_FILE=keys/wxo_embed_private.pem

# JWT token lifetime in seconds (max 7100 per IBM docs).
JWT_EXPIRY_SECONDS=3600

# Port for the local JWT signing server.
JWT_SERVER_PORT=3001

# Comma-separated list of allowed CORS origins for the JWT server.
# Add your production domain here when deploying.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# JWT audience claim (default: watsonx-orchestrate).
# Must match the value expected by the wxO tenant — only change if directed by IBM support.
JWT_AUDIENCE=watsonx-orchestrate
